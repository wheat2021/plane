# .env.mirrors.template - 国内镜像加速环境变量
#
# 使用方法:
#   1. 复制此文件: cp .env.mirrors.template .env.mirrors
#   2. 构建时加载: docker compose --env-file .env --env-file .env.mirrors up --build
#
# 或者直接导出环境变量后构建:
#   export $(cat .env.mirrors.template | grep -v '^#' | xargs)
#   docker compose up --build

# Python pip 镜像 (阿里云)
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com

# 备选 pip 镜像:
# 清华大学
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
#
# 华为云
# PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple/
# PIP_TRUSTED_HOST=repo.huaweicloud.com
