# ============================================================
# Plane 环境配置 - 仅包含 Secrets 和基础设施变量
# 非敏感的应用配置已内联到 compose.dev.yml / compose.prod.yml
# ============================================================

# --- 数据库 ---
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"

# --- 消息队列凭据 ---
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# --- 对象存储 (MinIO / S3) ---
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# 浏览器可访问的 MinIO 公共地址（开发环境直连，生产通过 Caddy 代理时留空）
MINIO_PUBLIC_URL="http://localhost:9000"
AWS_S3_BUCKET_NAME="uploads"
MINIO_ENDPOINT_SSL=0

# --- 应用 Secrets ---
SECRET_KEY="fc892225e1b61ca99fd376dea18cb9fe61ae05c23c48de55cf4dd7663fa65239"
LIVE_SERVER_SECRET_KEY="fc892225e1b61ca99fd376dea18cb9fe61ae05c23c48de55cf4dd7663fa65239"

# --- 部署配置（端口 & 代理）---
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0
